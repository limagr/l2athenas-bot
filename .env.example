# Token do bot (Discord Developer Portal > Bot > Reset Token)
BOT_TOKEN=

# ID do bot (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID do seu servidor Discord (clique direito no servidor > Copiar ID)
GUILD_ID=

# ID do cargo que libera os canais (crie o cargo "Membro" e copie o ID)
ROLE_MEMBRO_ID=

# ID do cargo que recebe os tickets (crie o cargo "Suporte" e copie o ID)
ROLE_SUPORTE_ID=

# ID da categoria onde os tickets serão criados (crie "TICKETS" e copie o ID)
CATEGORY_TICKETS_ID=

# ID do canal de status do servidor (onde o bot vai atualizar o embed)
CHANNEL_STATUS_ID=

# ID do canal de logs de moderação (ban, kick, tickets)
CHANNEL_MOD_LOG_ID=

# ID do canal de anúncios (comando /anuncio)
CHANNEL_ANNOUNCEMENTS_ID=

# ID do cargo a ser pingado quando o servidor voltar online
ROLE_JOGADORES_ID=

# URL do site (usada na DM de boas-vindas)
WEBSITE_URL=https://l2athenas.com

# ID do canal de boss (lista épicos e raids com status vivo/morto)
CHANNEL_BOSS_ID=

# ID do canal de downloads (embed com links do launcher e cliente)
CHANNEL_DOWNLOADS_ID=

# URLs dos downloads (mesmas do site)
NEXT_PUBLIC_LAUNCHER_DOWNLOAD_URL=https://downloads.l2athenas.com/AthenaLauncher.exe
NEXT_PUBLIC_CLIENT_DOWNLOAD_URL=https://drive.google.com/file/d/1LWKMGLerwfEaNXNFv-vRM0mH7tCsMI-J/view?usp=sharing

# ID do canal de clips (só aceita links do YouTube)
CHANNEL_CLIPS_ID=

# URL base da API do servidor (ex: https://api.l2athenas.com)
API_URL=
